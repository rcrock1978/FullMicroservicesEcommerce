{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=NotificationServiceDb;Username=postgres;Password=postgres"
  },
  "SendGrid": {
    "ApiKey": "your-sendgrid-api-key-here",
    "FromEmail": "noreply@ecommerce.com",
    "FromName": "E-Commerce Platform"
  },
  "Twilio": {
    "AccountSid": "your-twilio-account-sid-here",
    "AuthToken": "your-twilio-auth-token-here",
    "FromPhoneNumber": "+1234567890"
  },
  "JwtSettings": {
    "SecretKey": "your-super-secret-jwt-signing-key-min-32-characters",
    "Issuer": "EcommerceApp",
    "Audience": "EcommerceAppUsers",
    "ExpirationMinutes": 60
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
